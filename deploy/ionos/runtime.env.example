# Copier ce fichier en runtime.env dans le dossier du déploiement préparé.
# Choisir une clé aléatoire longue. Conserver la clé existante lors des mises à jour.
SECRET_KEY=replace-with-a-long-random-secret

# Paramètres SMTP facultatifs ; nécessaires pour les courriels de réinitialisation.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
